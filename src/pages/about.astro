---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bannerImage from '../assets/stray-dogs-together.jpg';
import shashwatPhoto from '../assets/team/shashwat.png';
import jesusPhoto from '../assets/team/jesus.jpg';
import johnnessaPhoto from '../assets/team/johnnessa.jpg';
import yugPhoto from '../assets/team/yug.jpg';
import rishabhPhoto from '../assets/team/rishabh.jpg';
import danielPhoto from '../assets/team/daniel.jpg';
import anantkumarPhoto from '../assets/team/anantkumar.jpg';
import beenaPhoto from '../assets/team/beena.webp';

const coreMembers = [
  { id: 'shashwat', name: 'Shashwat Raj', role: 'Chief Executive Officer & Founder', photo: shashwatPhoto },
  { id: 'jesus', name: 'Jesus Aguilar', role: 'Chief Operating Officer', photo: jesusPhoto },
  { id: 'johnnessa', name: 'Johnnessa Barroquillo', role: 'Chief Design Officer', photo: johnnessaPhoto },
  { id: 'yug', name: 'Yug Thapar', role: 'Chief Technological Officer', photo: yugPhoto },
  { id: 'rishabh', name: 'Rishabh Roy', role: 'Director & Chief of Logistics', photo: rishabhPhoto },
  { id: 'daniel', name: 'Daniel Abrams', role: 'Founding Engineer', photo: danielPhoto },
];

const communityPartners = [
  {
    name: 'Anantkumar Malikaveetil',
    role: 'Community Partner, Banyan Tree',
    photo: anantkumarPhoto,
    quote: '"WoofCare has the potential to revolutionize how we care for stray dogs in India"',
  },
  {
    name: 'Beena Malikaveetil',
    role: 'Advisor, Dogs Friendly Pune',
    photo: beenaPhoto,
    quote: '"This social-network method could be actually very helpful for NGOs and rescue shelters"',
  },
];
---

<Layout title="About Us" description="Learn about WoofCare's mission to help stray dogs and meet our dedicated team.">
  <!-- Hero Section -->
  <section class="about-hero page-banner">
    <div class="container">
      <div class="banner-copy">
        <h1>About WoofCare</h1>
        <p class="hero-subtitle">Building a compassionate community for stray dogs</p>
      </div>
    </div>
    <Image src={bannerImage} class="banner-photo" alt="Two stray dogs nuzzling each other outdoors" width={1200} height={800} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={80} loading="eager" fetchpriority="high" />
  </section>

  <!-- Problem Statement Section -->
  <section class="section problem-section">
    <div class="container">
      <h2 class="section-title">Understanding the Problem</h2>
      
      <div class="problem-content">
        <div class="problem-block">
          <h3>Dog Lovers' Dilemma</h3>
          <p>People who find stray dogs in need often want to help, but face practical questions:</p>
          <ul class="problem-list">
            <li>Can my household situation accommodate a rescue?</li>
            <li>Do I have the financial means for proper care?</li>
            <li>How can I access immediate veterinary care?</li>
            <li>Where are the nearest dog shelters or adoption centers?</li>
          </ul>
        </div>

        <div class="problem-block">
          <h3>Challenges for NGOs</h3>
          <p>Animal welfare organizations face limits in:</p>
          <ul class="problem-list">
            <li><strong>Limited Space:</strong> Shelters are often at full capacity</li>
            <li><strong>Limited Resources:</strong> Insufficient supplies and equipment</li>
            <li><strong>Limited Financial Assistance:</strong> Funding gaps prevent optimal care</li>
            <li><strong>Limited Network:</strong> Difficulty reaching potential helpers and adopters</li>
          </ul>
        </div>

        <div class="stats-block">
          <h3>The Scale of the Challenge</h3>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number">200M+</div>
              <div class="stat-label">Stray Dogs Worldwide</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">62M+</div>
              <div class="stat-label">Stray Dogs in India</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">$2,260</div>
              <div class="stat-label">Min. Annual Care Cost</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="section solution-section">
    <div class="container">
      <h2 class="section-title">Our Solution</h2>
      
      <div class="solution-intro">
        <p class="solution-tagline">A social networking app that connects dog lovers with nearby dog care resources.</p>
      </div>

      <div class="solution-features">
        <div class="solution-feature">
          <div class="feature-icon">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Report Need for Care or Help</h3>
          <p>Report stray dogs in need through the app, sharing their location, photos, and details to help others respond.</p>
        </div>

        <div class="solution-feature">
          <div class="feature-icon">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A1.5 1.5 0 0 0 18.54 8H16c-.8 0-1.54.37-2.01 1l-2.41 3.19c-.32.42-.26 1.02.14 1.37l2.41 2.13L12.92 18H11v2h1.5c.28 0 .5-.22.5-.5 0-.1-.04-.19-.1-.26L11.18 18H9.97L8 16.5l1.18-1.18L11.5 17H13l2.5-3.22L12.4 11.2C12.18 11.07 12 10.84 12 10.5c0-.83.67-1.5 1.5-1.5H16l2.54 7.63L20 22z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Help or Find Help</h3>
          <p>Connect with nearby veterinary clinics, rescue shelters, NGOs, dog feeders, and potential adopters to offer or find help.</p>
        </div>

        <div class="solution-feature">
          <div class="feature-icon">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Inspire Others to Join</h3>
          <p>Share success stories, adoption updates, and rescue experiences with other dog lovers in your community.</p>
        </div>
      </div>

      <div class="resources-list">
        <h3>Dog Help Resources Available:</h3>
        <div class="resources-tags">
          <span class="resource-tag">Vet Clinics</span>
          <span class="resource-tag">Dog Lovers</span>
          <span class="resource-tag">Dog Feeders</span>
          <span class="resource-tag">Rescue Shelters</span>
          <span class="resource-tag">NGOs</span>
          <span class="resource-tag">Open for Adoption</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Team Section -->
  <section class="section team-section">
    <div class="container">
      <h2 class="section-title">Meet Our Core Team</h2>
      <p class="section-subtitle">The people working to help stray dogs find care</p>

      <div class="team-grid">
        {coreMembers.map((member) => (
          <article class="team-member">
            <div class={`member-photo member-photo--${member.id}`}>
              <Image src={member.photo} alt={member.name} width={256} height={256} widths={[128, 256]} sizes="(max-width: 480px) 80px, 128px" format="webp" quality={85} loading="lazy" />
            </div>
            <div class="member-details">
              <h3>{member.name}</h3>
              <p class="member-role">{member.role}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="partners-section">
        <h3>Our Community Partners</h3>
        <div class="partners-grid">
          {communityPartners.map((partner) => (
            <article class="partner-card">
              <div class="partner-photo">
                <Image src={partner.photo} alt={partner.name} width={256} height={256} widths={[128, 256]} sizes="(max-width: 480px) 80px, 128px" format="webp" quality={85} loading="lazy" />
              </div>
              <div class="partner-details">
                <h4>{partner.name}</h4>
                <p>{partner.role}</p>
              </div>
              <p class="partner-quote">{partner.quote}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Section -->
  <section class="section impact-section">
    <div class="container">
      <h2 class="section-title">Our Impact Vision</h2>
      <div class="impact-grid">
        <div class="impact-card">
          <div class="impact-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.6 14.8,10V11.5C14.8,12.6 13.9,13.5 12.8,13.5H11.2C10.1,13.5 9.2,12.6 9.2,11.5V10C9.2,8.6 10.6,7 12,7Z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Safer Environment</h3>
          <p>Creating safer communities for citizens, protecting against rabies infection and dog attacks through better care and management.</p>
        </div>

        <div class="impact-card">
          <div class="impact-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5,3H7V5.5L9.5,3H16.5C18.71,3 20.39,4.81 20.5,7L15,12L20.5,17C20.39,19.19 18.71,21 16.5,21H9.5L7,18.5V21H5V3M9,5V7H16.5C17.85,7 19,8.15 19,9.5C19,10.85 17.85,12 16.5,12H9V14H16.5C17.85,14 19,15.15 19,16.5C19,17.85 17.85,19 16.5,19H9V17H7V5H9Z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Raise Awareness</h3>
          <p>Educating people about nearby help resources and teaching how to safely help stray dogs without getting hurt.</p>
        </div>

        <div class="impact-card">
          <div class="impact-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3zm5 15h-2v-6H9v6H7v-6.81l5-4.5 5 4.5V18z" fill="currentColor"/>
            </svg>
          </div>
          <h3>Provide Homes</h3>
          <p>Helping abandoned stray dogs find lasting homes through our adoption network.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    background: var(--primary-brown);
    color: var(--white);
    padding: 4rem 0;
    text-align: center;
  }

  .about-hero h1 {
    color: var(--white);
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--light-cream);
  }

  .section-title {
    text-align: left;
    color: var(--primary-brown);
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 2rem;
  }

  .section-subtitle {
    text-align: left;
    font-size: 1.1rem;
    color: var(--text-medium);
    max-width: 700px;
    margin: 0 0 3rem;
  }

  /* Problem Section */
  .problem-section {
    background-color: var(--light-cream);
  }

  .problem-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .problem-block {
    background-color: var(--white);
    padding: 2rem;
    border-radius: 12px;
    border-left: 5px solid var(--primary-brown);
  }

  .problem-block h3 {
    color: var(--dark-brown);
    margin-bottom: 1rem;
  }

  .problem-list {
    margin-left: 1.5rem;
    margin-top: 1rem;
  }

  .problem-list li {
    margin-bottom: 0.75rem;
    color: var(--text-medium);
  }

  .stats-block {
    grid-column: 1 / -1;
    background: var(--primary-brown);
    color: var(--white);
    padding: 2rem;
    border-radius: 12px;
    text-align: left;
  }

  .stats-block h3 {
    color: var(--white);
    margin-bottom: 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .stat-item {
    text-align: left;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 1rem;
    color: var(--light-cream);
  }

  /* Solution Section */
  .solution-section {
    background-color: var(--white);
  }

  .solution-intro {
    text-align: left;
    margin-bottom: 3rem;
  }

  .solution-tagline {
    font-size: 1.3rem;
    color: var(--dark-brown);
    font-weight: 600;
    max-width: 800px;
    margin: 0;
  }

  .solution-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .solution-feature {
    background-color: var(--cream);
    padding: 2rem;
    border-radius: 12px;
    text-align: left;
    transition: all 0.3s ease;
  }

  .solution-feature:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(184, 121, 43, 0.2);
  }

  .feature-icon {
    color: var(--primary-brown);
    margin-bottom: 1rem;
    display: flex;
    justify-content: flex-start;
  }

  .feature-icon svg {
    width: 56px;
    height: 56px;
  }

  .solution-feature h3 {
    color: var(--dark-brown);
    margin-bottom: 1rem;
  }

  .resources-list {
    background-color: var(--light-cream);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 3rem;
  }

  .resources-list h3 {
    color: var(--dark-brown);
    margin-bottom: 1.5rem;
  }

  .resources-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .resource-tag {
    background-color: var(--primary-brown);
    color: var(--white);
    padding: 0.5rem 1.25rem;
    border-radius: 25px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .competitive-advantage {
    background: var(--cream);
    padding: 2rem;
    border-radius: 12px;
  }

  .competitive-advantage h3 {
    color: var(--dark-brown);
    margin-bottom: 1rem;
  }

  .competitive-advantage ul {
    margin-left: 1.5rem;
    margin-top: 1rem;
  }

  .competitive-advantage li {
    margin-bottom: 0.75rem;
    color: var(--text-medium);
  }

  /* Team Section */
  .team-section {
    background: var(--cream);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .team-member {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    background-color: var(--white);
    padding: 1.5rem;
    border-radius: 12px;
    text-align: left;
    transition: all 0.3s ease;
  }

  .team-member:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px rgba(184, 121, 43, 0.3);
  }

  .member-photo,
  .partner-photo {
    width: 128px;
    height: 128px;
    border-radius: 8px;
    overflow: hidden;
  }

  .member-photo img,
  .partner-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-photo--rishabh img {
    transform: scale(1.65);
    transform-origin: 50% 35%;
  }

  .team-member h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--dark-brown);
    margin-bottom: 0.5rem;
  }

  .member-role {
    color: var(--primary-brown);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .member-details,
  .partner-details {
    min-width: 0;
  }

  .partner-details p {
    margin-bottom: 0;
  }

  .partners-section {
    margin-top: 4rem;
  }

  .partners-section h3 {
    text-align: left;
    color: var(--dark-brown);
    margin-bottom: 2rem;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .partner-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    background-color: var(--white);
    padding: 1.5rem;
    border-radius: 12px;
    text-align: left;
    border: 2px solid var(--primary-brown);
  }

  .partner-logo {
    margin-bottom: 1rem;
  }

  .partner-logo h4 {
    color: var(--primary-brown);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .partner-card h4 {
    color: var(--dark-brown);
    margin-bottom: 0.5rem;
  }

  .partner-quote {
    grid-column: 1 / -1;
    font-style: italic;
    color: var(--text-medium);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Impact Section */
  .impact-section {
    background-color: var(--white);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .impact-card {
    background: var(--cream);
    padding: 2rem;
    border-radius: 12px;
    text-align: left;
    transition: all 0.3s ease;
  }

  .impact-card:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(184, 121, 43, 0.2);
  }

  .impact-icon {
    color: var(--primary-brown);
    margin-bottom: 1rem;
    display: flex;
    justify-content: flex-start;
  }

  .impact-icon svg {
    width: 48px;
    height: 48px;
  }

  .impact-card h3 {
    color: var(--dark-brown);
    margin-bottom: 1rem;
  }

  .about-hero {
    position: relative;
    overflow: hidden;
    background: var(--primary-brown);
    padding: 0;
  }

  .about-hero h1 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    margin-bottom: 0;
  }

  .hero-subtitle {
    max-width: 720px;
    margin: 1.25rem 0 0;
    line-height: 1.55;
  }

  .section-title {
    color: var(--deep-brown);
  }

  .problem-section {
    background: var(--light-cream);
  }

  .problem-content {
    gap: 1.5rem;
  }

  .problem-block {
    border-left: 0;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    background: rgba(255, 255, 255, 0.82);
  }

  .stats-block {
    border-radius: 12px;
    background: var(--primary-brown);
    box-shadow: var(--shadow-md);
  }

  .stat-item {
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
  }

  .solution-section,
  .impact-section {
    background: rgba(255, 255, 255, 0.78);
  }

  .solution-feature,
  .impact-card,
  .team-member,
  .partner-card,
  .resources-list {
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-sm);
  }

  .solution-feature {
    background: var(--cream);
    border-radius: 12px;
  }

  .feature-icon,
  .impact-icon {
    width: fit-content;
    margin-left: 0;
    margin-right: 0;
    padding: 0.5rem;
    border-radius: 6px;
    background: rgba(184, 121, 43, 0.1);
  }

  .resources-list {
    border-radius: 12px;
    background: rgba(255, 249, 240, 0.9);
  }

  .resource-tag {
    border-radius: 6px;
    background: var(--primary-brown);
    border: 1px solid var(--dark-brown);
    box-shadow: none;
  }

  .team-section {
    background: var(--cream);
  }

  .team-section .section-title {
    margin-bottom: 0.75rem;
  }

  .team-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .team-member,
  .partner-card {
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
  }

  .team-member:hover,
  .solution-feature:hover,
  .impact-card:hover {
    transform: none;
    box-shadow: var(--shadow-md);
  }

  .member-photo,
  .partner-photo {
    box-shadow: none;
  }

  .partners-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .impact-card {
    border-radius: 12px;
    background: var(--cream);
  }

  .impact-card:hover {
    transform: none;
  }

  @media (max-width: 768px) {
    .about-hero h1 {
      font-size: 2.5rem;
    }

    .team-grid,
    .partners-grid,
    .problem-content,
    .solution-features,
    .impact-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .problem-block,
    .stats-block,
    .resources-list,
    .solution-feature,
    .team-member,
    .partner-card,
    .impact-card {
      padding: 1.5rem;
    }

    .team-grid {
      margin-bottom: 2.5rem;
    }

    .partners-section {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .team-member,
    .partner-card {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 1rem;
    }

    .member-photo,
    .partner-photo {
      width: 80px;
      height: 80px;
    }

    .team-member h3 {
      font-size: 1.125rem;
    }
  }
</style>
